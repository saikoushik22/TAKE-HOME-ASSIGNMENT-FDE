# =============================================================================
# The Lenny Growth Assistant — configuration
#
#   cp .env.example .env
#
# Every value here has a safe default. The stack runs fully local with NO edits
# and NO API keys: `docker compose up --build` plus a running Ollama is enough.
#
# NEVER commit .env. It is gitignored; .env.example is the only file that ships.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — but every one of these already has a working default.
# -----------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Compose builds DATABASE_URL from these three. Change the password before any
# deployment that is reachable from outside your machine.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
POSTGRES_PORT=5433

# Used ONLY when running the backend natively (outside Compose).
# Inside Compose the host is `db`, not `localhost`, and compose sets it for you.
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5433/lenny

# --- Active model provider ---------------------------------------------------
# ollama | anthropic | openai
# `ollama` is the default and is what the submitted demo runs on.
LLM_PROVIDER=ollama

# Optional override for the active provider's model. Leave blank to use that
# provider's own default below. It applies only to the ACTIVE provider, so it
# cannot leak a local model name into a cloud request.
LLM_MODEL=

# --- Ollama (local, the demo path) -------------------------------------------
# Ollama runs on the HOST, not in a container.
#   native backend  -> http://localhost:11434
#   compose backend -> http://host.docker.internal:11434  (compose sets this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=10m

# Load the models at startup instead of making the first user wait for it.
# MEASURED on the reference machine: a cold chat model costs ~51s to first
# token; the identical request warm costs ~0.7s. This is by far the largest
# single latency in the product. Runs in the background, never delays readiness.
LLM_WARMUP_ON_STARTUP=true

# --- Embeddings --------------------------------------------------------------
# Deliberately independent of the chat provider: embeddings stay local even when
# chat runs in the cloud, so switching to Anthropic does not silently start
# re-embedding the whole corpus through a paid API.
#
# WARNING: EMBEDDING_DIM must match EMBEDDING_MODEL's output, and changing
# either requires a full re-index (`make reset-index && make ingest`). Vectors
# from different models are not comparable, and the app refuses to serve
# retrieval on a mismatch rather than returning meaningless neighbours.
#   nomic-embed-text          -> 768
#   text-embedding-3-small    -> 1536
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32


# -----------------------------------------------------------------------------
# OPTIONAL — cloud providers. Leave blank to stay fully local.
#
# A provider with no key reports itself unavailable and is shown DISABLED in the
# UI with that reason attached, rather than hidden. Nothing breaks.
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set only for an OpenAI-compatible gateway (Azure, OpenRouter, LiteLLM, vLLM).
OPENAI_BASE_URL=

# --- Fallback behaviour ------------------------------------------------------
# OFF by default, on purpose. Silently answering with a different model than the
# one selected makes results irreproducible, and a cloud fallback would ship
# local data off the machine without consent. When enabled, a fallback is always
# surfaced in the UI ("answered by anthropic — ollama was unreachable").
#
# Fallback fires ONLY on transport failures (refused, timeout, 5xx). A semantic
# failure (bad request, context too long) does not retry elsewhere, because
# another provider would fail identically and hide the real bug.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=

# --- Generation tuning -------------------------------------------------------
LLM_TEMPERATURE=0.3
# A grounded answer measures ~320 tokens in practice. At ~10 tok/s on CPU the
# old 2048 ceiling allowed a single answer to run for three minutes.
LLM_MAX_TOKENS=1024
# Sized for CPU-only inference. A 3B model on CPU can genuinely take ~60s for a
# long answer; lower this only if you are on a GPU or a cloud provider.
LLM_TIMEOUT_SECONDS=180


# -----------------------------------------------------------------------------
# OPTIONAL — retrieval tuning. Defaults are measured against the golden set.
# -----------------------------------------------------------------------------

# Chunks passed to the model as evidence.
# THE MAIN SPEED/QUALITY DIAL. Prompt prefill runs at ~65 tokens/second on the
# reference CPU, so context length is paid directly in seconds before the user
# sees a single word. Raise for grounding breadth, lower for speed.
RAG_TOP_K=4

# Characters of EACH retrieved chunk actually sent to the model. Chunks average
# ~1,400 characters, and the passage that earned the retrieval is rarely the
# whole speaker turn — trimming keeps the number of distinct sources (and so the
# breadth of citations) while roughly halving the prompt. 0 disables trimming.
RAG_CONTEXT_CHARS_PER_CHUNK=800
# Candidates pulled from EACH retriever before fusion. Must be >= RAG_TOP_K.
RAG_CANDIDATES=30
# The relevance floor, and the most important safety knob in the system. Below
# this, retrieval returns empty and the model is NEVER CALLED — the assistant
# says the corpus does not cover the question instead of inventing an answer.
#
# CALIBRATED, NOT GUESSED. Measured cosine bands on nomic-embed-text:
#     in-corpus      0.44 - 0.73  (median 0.62)
#     out-of-corpus  0.43 - 0.55  (median 0.44)
# They OVERLAP — dense embeddings keep a high similarity floor for any
# same-language text, so no threshold separates them perfectly. 0.50 rejects 7
# of 8 known out-of-corpus questions while keeping 16 of 17 in-corpus ones.
#
# Re-calibrate with `make eval` after changing the corpus or embedding model;
# the right value is a property of BOTH, not a universal constant.
RAG_MIN_SIMILARITY=0.50
# Max chunks from any single episode, so one verbose interview cannot
# monopolise the context window.
RAG_MAX_PER_EPISODE=3
# Reciprocal Rank Fusion constant. 60 is the value from the original paper.
RAG_RRF_K=60


# -----------------------------------------------------------------------------
# OPTIONAL — ingestion.
# -----------------------------------------------------------------------------

# Public upstream corpus. Not vendored into this repo: it is third-party content
# and `make ingest` fetches it at setup time.
TRANSCRIPT_REPO=ChatPRD/lennys-podcast-transcripts
TRANSCRIPT_REF=main
# Point at an already-downloaded corpus to skip the network fetch entirely.
TRANSCRIPT_LOCAL_PATH=
DATA_DIR=./data
# Cap episodes for a fast smoke test. Blank = ingest everything.
INGEST_MAX_EPISODES=

# Chunking. Speaker-aware, so these are targets rather than hard splits.
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_TURNS=1


# -----------------------------------------------------------------------------
# OPTIONAL — agent, app, and observability.
# -----------------------------------------------------------------------------

# native      -> the provider-agnostic runtime. Works with Ollama. THE DEMO PATH.
# claude_sdk  -> delegates to the real claude-agent-sdk package.
#                Requires ANTHROPIC_API_KEY, `pip install -r requirements-dev.txt`,
#                and the Claude Code CLI on PATH. See architecture.md section 5.1.
AGENT_RUNTIME=native
AGENT_MAX_STEPS=4
# Let a model classify genuinely ambiguous messages. Deterministic rules always
# run first; this only handles what they cannot decide.
ROUTER_LLM_FALLBACK=true

# When an answer comes back with no [S#] markers, ask the model once to annotate
# its own draft. Raises citation coverage, but it is a SECOND full generation and
# roughly doubles latency on the turns where it fires. Set to false to trade
# citation coverage for speed on slow local hardware.
QA_CITATION_REPAIR=true

# Largest artifact accepted from a model, in bytes.
ARTIFACT_MAX_BYTES=512000

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_PORT=8001
FRONTEND_PORT=8081

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json    -> structured, for shipping to a log aggregator
# console -> human-readable, better when tailing locally
LOG_FORMAT=json

# Comma-separated. Must include the origin the browser actually loads the UI from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
