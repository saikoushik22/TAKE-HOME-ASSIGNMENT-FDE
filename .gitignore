__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.local

