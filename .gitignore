# ---------- Secrets: never commit ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Transcript corpus ----------
# The Lenny's Podcast transcripts are third-party content. We do NOT redistribute
# them in this repo; `make ingest` fetches them from the upstream public repo at
# setup time. See docs/architecture.md -> "Ingestion".
#
# Matches a `data/` directory at ANY depth. The bare `data/transcripts/` rule
# this replaces missed `backend/data/`, which is where the corpus actually lands
# when the ingest CLI runs with the backend as its working directory.
data/
*.jsonl
*.sqlite

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---------- Editors / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Runtime ----------
logs/
*.log
pgdata/
